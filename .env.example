# Credenciais públicas do Firebase (Console > Configurações do projeto > Seus apps > Web)
# Copie para .env.local e preencha. .env.local NUNCA vai pro git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use "true" para desenvolver contra o Firebase Emulator Suite em vez do projeto real
VITE_USAR_EMULADOR=false
